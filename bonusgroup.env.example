# FlowDesk: Bonus Group server environment template
# On the server: cp bonusgroup.env.example .env, fill in, chmod 600 .env
# Never commit the real .env.

ENVIRONMENT=production

# ── Database ────────────────────────────────────────────────
# DB_* are read by docker-compose for the postgres container.
# DATABASE_URL must use the SAME user/password/name.
# Generate the password with: openssl rand -hex 16
DB_NAME=flowdesk
DB_USER=flowdesk_user
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg2://flowdesk_user:CHANGE_ME@flowdesk-db:5432/flowdesk

# ── Security ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_HTTPS=true

# ── Public address ──────────────────────────────────────────
# The URL users actually type. Keeps :8443 until the office router
# forwards port 443 directly; then drop the port here and rebuild nothing,
# just: docker compose -f docker-compose.bonusgroup.yml up -d
FRONTEND_URL=https://flowdesk.apps.bonusgroup.rw:8443
# Second entry covers testing at home (hosts file, no port).
ALLOWED_ORIGINS=https://flowdesk.apps.bonusgroup.rw:8443,https://flowdesk.apps.bonusgroup.rw

# ── Email ───────────────────────────────────────────────────
SMTP_HOST=mail.bonusgroup.rw
SMTP_PORT=587
SMTP_USER=flowdesk@bonusgroup.rw
SMTP_PASS=CHANGE_ME
SMTP_FROM=flowdesk@bonusgroup.rw
SMTP_TLS=true
# false = no emails sent at all (safe while testing)
EMAIL_NOTIFICATIONS_ENABLED=false

# ── Application ─────────────────────────────────────────────
APP_NAME=FlowDesk
MEDIA_DIR=media
SUPER_ADMIN_EMAIL=CHANGE_ME@bonusgroup.rw
