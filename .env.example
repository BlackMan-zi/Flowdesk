# ============================================================================
# FlowDesk — environment template. Copy to .env and fill in real values.
# Never commit a populated .env (it is gitignored).
# ============================================================================
ENVIRONMENT=development

# ============================================================================
# DATABASE  (required — no default; the app will not start without it)
# ============================================================================
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3308/flowdesk

# Docker MySQL container (used by docker-compose.yml interpolation)
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=flowdesk

# ============================================================================
# SECURITY — JWT  (required — no default)
# Generate with: openssl rand -hex 32
# ============================================================================
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# CORS
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ============================================================================
# SMTP — Microsoft Exchange Online (leave SMTP_USER blank to disable email)
# ============================================================================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
SMTP_TLS=true

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=FlowDesk
FRONTEND_URL=http://localhost:3000
MEDIA_DIR=media
REQUIRE_HTTPS=false

# ============================================================================
# BOOTSTRAP ADMIN (created on first startup only)
# Leave SUPER_ADMIN_PASSWORD blank to auto-generate one (printed once in logs).
# ============================================================================
SUPER_ADMIN_EMAIL=admin@flowdesk.com
SUPER_ADMIN_PASSWORD=
